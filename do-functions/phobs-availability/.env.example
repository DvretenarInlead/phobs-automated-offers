# Copy to .env and fill in real values, then deploy with:
#   doctl serverless deploy . --env .env
# .env is gitignored.

PHOBS_ENDPOINT=https://YOUR-PHOBS-HOST.phobs.net/PATH
PHOBS_SITE_ID=
PHOBS_USERNAME=
PHOBS_PASSWORD=

# Needed by phobs/sync-line-items (HubSpot Private App token with scopes:
# crm.objects.deals.write, crm.objects.products.read/write,
# crm.objects.line_items.write, e-commerce)
HUBSPOT_ACCESS_TOKEN=

# Optional bearer gate for the webhooks. When set, callers must send
#   Authorization: Bearer <API_TOKEN>
# Leave empty to keep the URLs open (not recommended for sync-line-items,
# since it writes to your CRM).
API_TOKEN=
