# Phobs (mandatory)
PHOBS_ENDPOINT=https://api.phobs.net/PC/PCPropertyAvailability
PHOBS_SITE_ID=
PHOBS_USERNAME=
PHOBS_PASSWORD=

# HubSpot Private App (mandatory)
# Scopes: crm.objects.deals.read/write, crm.objects.products.read/write,
#         crm.objects.line_items.read/write, crm.objects.quotes.read/write,
#         (optional) e-commerce
HUBSPOT_ACCESS_TOKEN=
HUBSPOT_QUOTE_TEMPLATE_ID=
HUBSPOT_OWNER_ID=

# Quote defaults (optional)
QUOTE_EXPIRATION_DAYS=3
QUOTE_DEFAULT_CURRENCY=EUR
# Set to 'false' to skip writing quote_id / phobs_availability_status back to the deal.
QUOTE_WRITEBACK_STATUS=true

# HTTP (optional)
PORT=8080
# If set, callers MUST send `Authorization: Bearer <API_TOKEN>` on POST /run.
# Leave blank to expose the endpoint without auth (put it behind your own proxy).
API_TOKEN=
